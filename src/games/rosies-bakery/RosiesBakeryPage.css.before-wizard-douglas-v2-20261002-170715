.wizard-bakery-page {
  width: min(100%, 1180px);
  height: 100svh;
  margin: 0 auto;
  padding: 12px 18px 72px;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  gap: 12px;
  overflow: hidden;
  background: #fff9ef;
  color: #171717;
}

.wizard-bakery-topbar {
  display: grid;
  grid-template-columns: 100px 1fr 100px;
  gap: 12px;
  align-items: center;
}

.wizard-bakery-title {
  display: grid;
  place-items: center;
}

.wizard-bakery-title span {
  font-size: 0.58rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.wizard-bakery-title h1 {
  margin: 0;
  font-size: clamp(1.9rem, 5vh, 3.9rem);
  line-height: 0.9;
  text-transform: uppercase;
}

.wizard-bakery-nav,
.wizard-bakery-next,
.wizard-bakery-difficulty button,
.wizard-pantry__item,
.wizard-card,
.wizard-bakery-speech {
  border: 3px solid #171717;
  box-shadow: 3px 4px 0 #171717;
}

.wizard-bakery-nav,
.wizard-bakery-next {
  min-height: 42px;
  display: grid;
  place-items: center;
  padding: 7px 10px;
  border-radius: 14px;
  background: #fffdf8;
  color: #171717;
  text-decoration: none;
  font: inherit;
  font-weight: 800;
}

.wizard-bakery-nav:active,
.wizard-bakery-next:active,
.wizard-bakery-difficulty button:active,
.wizard-pantry__item:active {
  transform: translate(3px, 4px);
  box-shadow: none;
}

.wizard-bakery-stage {
  min-height: 0;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
  gap: 12px;
  padding: 14px;
  border: 4px solid #171717;
  border-radius: 24px;
  background:
    radial-gradient(circle at top left, rgba(255, 227, 59, 0.28), transparent 22%),
    radial-gradient(circle at top right, rgba(255, 157, 200, 0.18), transparent 18%),
    linear-gradient(180deg, #fff6e3 0%, #fffdf8 100%);
  overflow: hidden;
}

.wizard-bakery-hero {
  display: grid;
  grid-template-columns: 120px minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
}

.wizard-bakery-host {
  position: relative;
  height: 112px;
  border: 4px solid #171717;
  border-radius: 22px;
  background: linear-gradient(180deg, #ff9dca 0%, #ffe56e 100%);
  overflow: hidden;
}

.wizard-bakery-host__hat,
.wizard-bakery-host__face,
.wizard-bakery-host__stars {
  position: absolute;
  display: block;
}

.wizard-bakery-host__hat {
  left: 25px;
  top: 10px;
  width: 70px;
  height: 42px;
  border: 4px solid #171717;
  border-radius: 60% 60% 28% 28%;
  background: #6d49d9;
}

.wizard-bakery-host__hat::before {
  content: '';
  position: absolute;
  left: 10px;
  right: 10px;
  bottom: 6px;
  height: 8px;
  border-radius: 999px;
  background: #ffd83d;
}

.wizard-bakery-host__face {
  left: 28px;
  bottom: 12px;
  width: 64px;
  height: 46px;
  border: 4px solid #171717;
  border-radius: 48px;
  background: #171717;
  box-shadow: inset 0 -4px 0 rgba(255, 255, 255, 0.15);
}

.wizard-bakery-host__face::before,
.wizard-bakery-host__face::after {
  content: '';
  position: absolute;
  top: 11px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #fff;
}

.wizard-bakery-host__face::before { left: 12px; }
.wizard-bakery-host__face::after { right: 12px; }

.wizard-bakery-host__stars {
  inset: 0;
  background:
    radial-gradient(circle at 84% 24%, #ffe33b 0 6px, transparent 7px),
    radial-gradient(circle at 78% 60%, #ffe33b 0 5px, transparent 6px),
    radial-gradient(circle at 18% 74%, #ffe33b 0 4px, transparent 5px),
    radial-gradient(circle at 22% 22%, #171717 0 2px, transparent 3px),
    radial-gradient(circle at 83% 12%, #171717 0 2px, transparent 3px);
}

.wizard-bakery-speech {
  min-height: 90px;
  display: grid;
  align-content: center;
  gap: 3px;
  padding: 12px 14px;
  border-radius: 18px;
  background: #fffdf8;
}

.wizard-bakery-speech span,
.wizard-card__eyebrow,
.wizard-card__player {
  font-size: 0.58rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.wizard-bakery-speech strong {
  font-size: 1.4rem;
  line-height: 0.95;
}

.wizard-bakery-speech p,
.wizard-card p {
  margin: 0;
  font-size: 0.88rem;
}

.wizard-bakery-difficulty {
  display: flex;
  gap: 6px;
  align-items: center;
}

.wizard-bakery-difficulty button {
  height: 38px;
  min-width: 82px;
  padding: 0 12px;
  border-radius: 999px;
  background: #fffdf8;
  color: #171717;
  font: inherit;
  font-size: 0.68rem;
  text-transform: uppercase;
}

.wizard-bakery-difficulty button.is-active {
  background: #ffe33b;
}

.wizard-bakery-workspace {
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(260px, 0.95fr) minmax(300px, 1.05fr);
  gap: 12px;
}

.wizard-card {
  min-height: 0;
  display: grid;
  grid-template-rows: auto auto auto minmax(0, 1fr) auto;
  gap: 8px;
  padding: 14px;
  border-radius: 22px;
  background: #fffdf8;
}

.wizard-card--order {
  background: linear-gradient(180deg, #fff4cc 0%, #fffdf8 100%);
}

.wizard-card--build {
  background: linear-gradient(180deg, #dff7ff 0%, #fffdf8 100%);
}

.wizard-card h2 {
  margin: 0;
  font-size: 1.4rem;
  line-height: 0.95;
}

.wizard-card__player {
  width: fit-content;
  padding: 5px 10px;
  border: 2px solid #171717;
  border-radius: 999px;
  background: #fff;
}

.wizard-bakery-next {
  justify-self: start;
  padding-inline: 16px;
  background: #72d64d;
}

.wizard-treat {
  min-height: 0;
  display: grid;
  align-content: end;
  justify-items: center;
}

.wizard-treat__stack {
  min-height: 220px;
  width: 100%;
  display: flex;
  flex-direction: column-reverse;
  align-items: center;
  justify-content: flex-start;
  gap: 6px;
}

.wizard-treat__slot {
  width: 172px;
  min-height: 42px;
  display: grid;
  place-items: center;
}

.wizard-treat__slot--ghost {
  opacity: 0.28;
}

.wizard-treat__ghost {
  width: 110px;
  height: 14px;
  border-radius: 999px;
  background: rgba(23, 23, 23, 0.14);
}

.wizard-treat__plate {
  width: 210px;
  height: 24px;
  display: block;
  border: 4px solid #171717;
  border-radius: 999px;
  background: #bdeafe;
}

.wizard-pantry {
  min-height: 0;
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 10px;
}

.wizard-pantry__item {
  min-height: 112px;
  display: grid;
  grid-template-rows: 66px auto;
  gap: 4px;
  place-items: center;
  padding: 8px 6px;
  border-radius: 16px;
  background: #fffdf8;
  font: inherit;
  color: #171717;
}

.wizard-pantry__item strong {
  font-size: 0.62rem;
  line-height: 1;
  text-align: center;
}

.wizard-pantry__item.is-wrong {
  background: #ffcbcf;
  animation: wizard-bakery-shake 180ms 2;
}

@keyframes wizard-bakery-shake {
  50% { transform: translateX(7px); }
}

.wizard-ingredient {
  position: relative;
  width: 122px;
  height: 60px;
  display: inline-block;
}

.wizard-ingredient i,
.wizard-ingredient b,
.wizard-ingredient em {
  position: absolute;
  display: block;
  box-sizing: border-box;
}

.wizard-ingredient i {
  left: 9%;
  right: 9%;
  top: 18%;
  bottom: 16%;
  border: 3px solid #171717;
  border-radius: 999px;
}

.wizard-ingredient--cake-base i,
.wizard-ingredient--pancake i {
  background: #eab86e;
}

.wizard-ingredient--cake-base i {
  top: 28%;
  bottom: 20%;
  border-radius: 12px;
}

.wizard-ingredient--cream i,
.wizard-ingredient--buttercream i,
.wizard-ingredient--pink-frosting i,
.wizard-ingredient--glaze i {
  left: 16%;
  right: 16%;
  top: 8%;
  bottom: 14%;
  border-radius: 58% 58% 44% 44%;
}

.wizard-ingredient--cream i { background: #fff8e9; }
.wizard-ingredient--buttercream i { background: #ffe56b; }
.wizard-ingredient--pink-frosting i { background: #ff92b6; }
.wizard-ingredient--glaze i { background: #fff1da; }

.wizard-ingredient--sprinkles i {
  left: 20%;
  right: 20%;
  top: 16%;
  bottom: 28%;
  border: 0;
  background: repeating-linear-gradient(90deg, #ff5f7f 0 6px, #ffd83d 6px 12px, #40bde0 12px 18px);
  clip-path: ellipse(44% 32%);
}

.wizard-ingredient--cherry i,
.wizard-ingredient--berry i {
  left: 41%;
  right: 41%;
  top: 10%;
  bottom: 34%;
  background: #e94d57;
  border-radius: 50%;
}

.wizard-ingredient--cherry b,
.wizard-ingredient--berry b {
  left: 50%;
  top: 8%;
  width: 12px;
  height: 10px;
  border-left: 3px solid #171717;
  border-radius: 50%;
  transform: rotate(18deg);
}

.wizard-ingredient--strawberry i {
  left: 36%;
  right: 36%;
  top: 10%;
  bottom: 18%;
  border-radius: 48% 48% 60% 60%;
  background: #ff626e;
}

.wizard-ingredient--strawberry b {
  left: 45%;
  top: 6%;
  width: 16px;
  height: 10px;
  background: #6fc85f;
  border: 3px solid #171717;
  border-radius: 999px 999px 5px 5px;
}

.wizard-ingredient--cookie i {
  left: 30%;
  right: 30%;
  top: 10%;
  bottom: 10%;
  background: #e6b165;
  border-radius: 50%;
}

.wizard-ingredient--cookie b,
.wizard-ingredient--cookie em {
  border: 0;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #7a472c;
}

.wizard-ingredient--cookie b {
  left: 44%;
  top: 20%;
  box-shadow: 16px 6px 0 #7a472c, -12px 16px 0 #7a472c, 9px 23px 0 #7a472c;
}

.wizard-ingredient--donut i {
  left: 24%;
  right: 24%;
  top: 10%;
  bottom: 10%;
  border-radius: 50%;
  background: #e8bc73;
}

.wizard-ingredient--donut b {
  left: 39%;
  right: 39%;
  top: 25%;
  bottom: 25%;
  border: 3px solid #171717;
  border-radius: 50%;
  background: #fffdf8;
}

.wizard-ingredient--croissant i {
  left: 18%;
  right: 18%;
  top: 16%;
  bottom: 18%;
  border-radius: 52% 52% 42% 42%;
  background: #f2bf63;
  clip-path: polygon(0 66%, 14% 24%, 34% 6%, 50% 18%, 66% 6%, 86% 24%, 100% 66%, 82% 90%, 18% 90%);
}

.wizard-ingredient--butter i {
  left: 32%;
  right: 32%;
  top: 24%;
  bottom: 24%;
  border-radius: 6px;
  background: #ffe56b;
}

.wizard-ingredient--syrup i {
  left: 18%;
  right: 18%;
  top: 40%;
  bottom: 28%;
  border-radius: 999px;
  background: #915130;
  transform: rotate(-4deg);
}

@media (max-width: 900px) {
  .wizard-bakery-hero {
    grid-template-columns: 88px minmax(0, 1fr);
  }

  .wizard-bakery-difficulty {
    grid-column: 1 / -1;
    justify-content: center;
  }

  .wizard-bakery-workspace {
    grid-template-columns: 1fr;
  }

  .wizard-pantry {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .wizard-bakery-page {
    padding: 8px;
    gap: 8px;
  }

  .wizard-bakery-topbar {
    grid-template-columns: 78px 1fr 78px;
    gap: 8px;
  }

  .wizard-bakery-title span {
    display: none;
  }

  .wizard-bakery-title h1 {
    font-size: 1.45rem;
  }

  .wizard-bakery-nav,
  .wizard-bakery-next {
    min-height: 38px;
    font-size: 0.72rem;
  }

  .wizard-bakery-stage {
    padding: 10px;
    gap: 10px;
  }

  .wizard-bakery-hero {
    grid-template-columns: 1fr;
  }

  .wizard-bakery-host {
    display: none;
  }

  .wizard-bakery-speech strong {
    font-size: 1.1rem;
  }

  .wizard-card {
    padding: 12px;
  }

  .wizard-card h2 {
    font-size: 1.18rem;
  }

  .wizard-treat__stack {
    min-height: 164px;
  }

  .wizard-treat__slot {
    width: 132px;
    min-height: 32px;
  }

  .wizard-treat__plate {
    width: 164px;
    height: 18px;
  }

  .wizard-pantry {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .wizard-pantry__item {
    min-height: 94px;
    grid-template-rows: 54px auto;
    padding: 6px 4px;
  }

  .wizard-pantry__item strong {
    font-size: 0.54rem;
  }

  .wizard-ingredient {
    width: 96px;
    height: 52px;
  }
}

@media (max-height: 560px) and (orientation: landscape) {
  .wizard-bakery-page {
    padding: 6px 10px 66px;
    gap: 6px;
  }

  .wizard-bakery-title h1 {
    font-size: 1.35rem;
  }

  .wizard-bakery-stage {
    gap: 8px;
    padding: 10px;
  }

  .wizard-bakery-hero {
    grid-template-columns: 88px minmax(0, 1fr) auto;
  }

  .wizard-bakery-host {
    height: 80px;
  }

  .wizard-bakery-speech {
    min-height: 70px;
    padding: 10px 12px;
  }

  .wizard-bakery-speech strong {
    font-size: 1rem;
  }

  .wizard-card {
    gap: 6px;
    padding: 10px;
  }

  .wizard-treat__stack {
    min-height: 134px;
  }

  .wizard-pantry {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
  }

  .wizard-pantry__item {
    min-height: 82px;
    grid-template-rows: 46px auto;
  }

  .wizard-ingredient {
    width: 84px;
    height: 44px;
  }
}

