.spot-it-game {
  width: min(100%, 1120px);
  height: 100svh;
  margin: 0 auto;
  padding: 18px 24px 22px;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  gap: 16px;
  overflow: hidden;
  background: #fffaf0;
  color: #171717;
}

.spot-it-topbar {
  display: grid;
  grid-template-columns: 116px 1fr 116px;
  align-items: center;
  gap: 12px;
}

.spot-it-topbar h1 {
  margin: 0;
  text-align: center;
  font-size: clamp(2rem, 5vh, 4.1rem);
  line-height: .9;
  text-transform: uppercase;
  letter-spacing: -.055em;
}

.spot-it-home,
.spot-it-score-card,
.spot-it-best-card {
  border: 3px solid #171717;
  border-radius: 16px 13px 17px 14px;
  background: #fffdf8;
  box-shadow: 3px 4px 0 #171717;
  color: #171717;
}

.spot-it-home {
  min-height: 44px;
  display: grid;
  place-items: center;
  padding: 7px 12px;
  text-decoration: none;
}

.spot-it-home:active {
  transform: translate(3px, 4px);
  box-shadow: none;
}

.spot-it-score-card {
  justify-self: end;
  min-width: 100px;
  min-height: 56px;
  display: grid;
  place-items: center;
  padding: 7px 12px;
  text-align: center;
}

.spot-it-score-card span,
.spot-it-best-card span {
  display: block;
  font-size: .63rem;
  line-height: 1;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.spot-it-score-card strong,
.spot-it-best-card strong {
  display: block;
  margin-top: 3px;
  font-size: 1.25rem;
  line-height: 1;
}

.spot-it-stage {
  position: relative;
  min-height: 0;
  overflow: hidden;
  border: 4px solid #171717;
  border-radius: 22px 18px 24px 19px;
  background-color: #fffdf8;
  background-image:
    linear-gradient(
      rgb(32 185 223 / .17) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgb(32 185 223 / .17) 1px,
      transparent 1px
    );
  background-size: 22px 22px;
}

.spot-it-best-card {
  position: absolute;
  z-index: 30;
  top: 14px;
  left: 14px;
  min-width: 92px;
  min-height: 62px;
  display: grid;
  place-items: center;
  padding: 7px 10px;
  text-align: center;
}

.spot-it-controls {
  position: absolute;
  z-index: 35;
  top: 14px;
  left: 50%;
  width: min(720px, 72%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  transform: translateX(-50%);
}

.spot-it-status {
  min-width: 0;
  margin: 0;
  padding: 8px 15px;
  overflow: hidden;
  border: 3px solid #171717;
  border-radius: 999px;
  background: #ffe33b;
  box-shadow: 3px 4px 0 #171717;
  font-size: .78rem;
  line-height: 1.05;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spot-it-status--found {
  background: #72d64d;
}

.spot-it-status--wrong {
  background: #ff8cae;
}

.spot-it-crowd-picker {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 6px 8px;
  border: 3px solid #171717;
  border-radius: 15px 12px 16px 13px;
  background: #fffdf8;
  box-shadow: 3px 4px 0 #171717;
}

.spot-it-crowd-picker > span {
  font-size: .61rem;
  letter-spacing: .05em;
  text-transform: uppercase;
}

.spot-it-crowd-picker > div {
  display: flex;
  gap: 4px;
}

.spot-it-crowd-picker button {
  min-width: 34px;
  height: 31px;
  display: grid;
  place-items: center;
  padding: 0 6px;
  border: 2px solid #171717;
  border-radius: 999px;
  background: #fffdf8;
  color: #171717;
  box-shadow: 1px 2px 0 #171717;
  font-size: .66rem;
}

.spot-it-crowd-picker button.is-active {
  background: #20b9df;
  transform: translateY(-2px);
}

.spot-it-crowd-picker button:active {
  transform: translate(1px, 2px);
  box-shadow: none;
}

.spot-it-board {
  position: absolute;
  inset: 92px 14px 14px;
  display: grid;
  gap: clamp(3px, .7vw, 8px);
}

.spot-it-board.is-paused {
  pointer-events: none;
}

.spot-it-tile {
  position: relative;
  min-width: 0;
  min-height: 0;
  padding: 1px;
  display: grid;
  place-items: center;
  overflow: visible;
  border: 0;
  background: transparent;
  cursor: pointer;
  touch-action: manipulation;
}

.spot-it-tile::after {
  content: '';
  position: absolute;
  z-index: 0;
  left: 20%;
  right: 20%;
  bottom: 7%;
  height: 7%;
  border-radius: 50%;
  background: rgb(23 23 23 / .11);
  transform: scaleX(.9);
}

.spot-it-tile img {
  position: relative;
  z-index: 1;
  width: 94%;
  height: 94%;
  display: block;
  object-fit: contain;
  user-select: none;
  pointer-events: none;
  transform-origin: center bottom;
  transition:
    transform 150ms ease,
    filter 150ms ease;
}

.spot-it-tile:active:not(:disabled) img {
  transform: scale(.88) !important;
}

.spot-it-tile.is-wrong img {
  animation: spot-it-wrong 300ms ease both;
}

.spot-it-tile.is-found img {
  animation: spot-it-found 700ms cubic-bezier(.2, 1.2, .3, 1) both;
}

.spot-it-tile.is-found::before {
  content: '';
  position: absolute;
  z-index: 0;
  inset: 2%;
  border: 4px solid #171717;
  border-radius: 50%;
  background: #72d64d;
  transform: rotate(-5deg);
}

.spot-it-feedback {
  position: absolute;
  z-index: 70;
  left: 50%;
  top: 54%;
  transform: translate(-50%, -50%) rotate(-6deg);
  font-size: clamp(3rem, 9vw, 7rem);
  line-height: .82;
  letter-spacing: -.05em;
  -webkit-text-stroke: 4px #171717;
  paint-order: stroke fill;
  pointer-events: none;
}

.spot-it-feedback--found {
  color: #72d64d;
}

.spot-it-feedback--wrong {
  color: #ffe33b;
}

@keyframes spot-it-wrong {
  0%, 100% {
    transform: translateX(0) rotate(0deg) scale(1);
  }

  25% {
    transform: translateX(-8px) rotate(-6deg) scale(.95);
  }

  55% {
    transform: translateX(8px) rotate(6deg) scale(.95);
  }

  80% {
    transform: translateX(-4px) rotate(-3deg) scale(.98);
  }
}

@keyframes spot-it-found {
  0% {
    transform: translateY(0) rotate(0deg) scale(1);
  }

  42% {
    transform: translateY(-24%) rotate(-8deg) scale(1.18);
  }

  68% {
    transform: translateY(-12%) rotate(7deg) scale(1.1);
  }

  100% {
    transform: translateY(-18%) rotate(-2deg) scale(1.12);
  }
}

@media (max-width: 820px) {
  .spot-it-game {
    padding: 12px;
  }

  .spot-it-topbar {
    grid-template-columns: 86px 1fr 86px;
  }

  .spot-it-score-card {
    min-width: 78px;
  }

  .spot-it-controls {
    width: calc(100% - 28px);
    top: 88px;
  }

  .spot-it-best-card {
    min-width: 78px;
    min-height: 54px;
  }

  .spot-it-board {
    inset: 154px 8px 8px;
    gap: 3px;
  }

  .spot-it-status {
    max-width: 48%;
    font-size: .67rem;
  }
}

@media (max-width: 560px) {
  .spot-it-controls {
    align-items: stretch;
    flex-direction: column;
    gap: 6px;
  }

  .spot-it-status {
    max-width: 100%;
  }

  .spot-it-board {
    top: 190px;
  }

  .spot-it-crowd-picker {
    justify-content: center;
  }
}
