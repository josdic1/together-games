.cake-drop-game {
  width: min(100%, 960px);
  height: 100dvh;
  max-height: 100dvh;
  margin: 0 auto;
  padding: 12px 28px 16px;

  display: grid;
  grid-template-rows:
    auto
    auto
    auto
    minmax(0, 1fr)
    auto
    auto;
  gap: 10px;

  overflow: hidden;
}

.cake-drop-topbar {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 16px;
}

.cake-drop-topbar h1 {
  margin: 0;
  font-size: clamp(2.6rem, 5vh, 4rem);
  line-height: 0.9;
  letter-spacing: -0.04em;
}

.cake-drop-home,
.cake-drop-reset,
.cake-drop-mode {
  min-height: 46px;
  padding: 7px 16px;

  border: 4px solid var(--ink);
  border-radius: 999px;

  background: var(--paper);
  color: var(--ink);

  box-shadow: 0 4px 0 rgb(42 33 24 / 15%);
  text-decoration: none;
  cursor: pointer;
}

.cake-drop-home {
  justify-self: start;
}

.cake-drop-reset {
  justify-self: end;
}

.cake-drop-home:active,
.cake-drop-reset:active,
.cake-drop-mode:active {
  transform: translateY(4px);
  box-shadow: none;
}

.cake-drop-hud {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 14px;
}

.cake-drop-player {
  min-height: 64px;
  padding: 9px 16px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  border: 4px solid var(--ink);
  border-radius: 22px;

  box-shadow: 0 4px 0 rgb(42 33 24 / 15%);
}

.cake-drop-player--one {
  background: var(--tomato);
}

.cake-drop-player--two {
  background: var(--sea);
}

.cake-drop-player:not(.is-active) {
  opacity: 0.4;
  transform: scale(0.95);
}

.cake-drop-player.is-active {
  transform: translateY(-3px) scale(1.02);
}

.cake-drop-player strong {
  padding: 5px 10px;

  border: 3px solid var(--ink);
  border-radius: 999px;

  background: var(--paper);

  font-size: 0.78rem;
  white-space: nowrap;
}

.cake-drop-stats {
  display: flex;
  gap: 7px;
}

.cake-drop-stats span {
  min-width: 72px;
  padding: 7px 10px;

  border: 3px solid var(--ink);
  border-radius: 18px;

  background: var(--paper);

  text-align: center;
  font-size: 0.72rem;
}

.cake-drop-stats strong {
  display: block;
  font-size: 1.2rem;
}

.cake-drop-status {
  width: fit-content;
  max-width: 100%;

  margin: 0 auto;
  padding: 6px 16px;

  border: 4px solid var(--ink);
  border-radius: 999px;

  background: var(--sun);

  box-shadow: 0 4px 0 rgb(42 33 24 / 15%);

  font-size: 0.9rem;
  text-align: center;
}

.cake-drop-status--warn {
  background: var(--tomato);
}

.cake-drop-stage {
  position: relative;
  min-height: 0;
  overflow: hidden;

  border: 5px solid var(--ink);
  border-radius: 30px;

  background: var(--paper);

  box-shadow: 0 6px 0 rgb(42 33 24 / 15%);
}

.cake-drop-guide {
  position: absolute;
  top: 76px;
  bottom: 0;
  left: 50%;

  width: 4px;

  border-radius: 999px;
  background: rgb(42 33 24 / 9%);

  transform: translateX(-50%);
}

.cake-drop-belt {
  position: absolute;
  inset: 0 0 auto;
  height: 78px;
}

.cake-drop-rail {
  position: absolute;
  top: 54px;
  left: 24px;
  right: 24px;

  height: 13px;

  border: 4px solid var(--ink);
  border-radius: 999px;

  background: var(--paper);
}

.cake-drop-roller {
  position: absolute;
  top: 43px;

  width: 34px;
  height: 34px;

  border: 4px solid var(--ink);
  border-radius: 50%;

  background: var(--paper);
}

.cake-drop-roller--left {
  left: 12px;
}

.cake-drop-roller--right {
  right: 12px;
}

.cake-drop-layer {
  position: absolute;

  border: 5px solid var(--ink);
  border-radius: 13px;

  box-shadow: 0 4px 0 rgb(42 33 24 / 15%);

  transform: translateX(-50%);
}

.cake-drop-layer--tomato {
  background: var(--tomato);
}

.cake-drop-layer--sun {
  background: var(--sun);
}

.cake-drop-layer--sea {
  background: var(--sea);
}

.cake-drop-layer--band::after {
  content: '';

  position: absolute;
  left: 8px;
  right: 8px;
  bottom: 5px;

  height: 7px;

  border: 3px solid var(--ink);
  border-radius: 999px;

  background: var(--paper);
}

.cake-drop-tower {
  position: absolute;
  left: 0;
  right: 0;

  transform-origin: bottom center;

  transition:
    bottom 220ms cubic-bezier(.2, .9, .3, 1.25);
}

.cake-drop-tower--tipping {
  animation: cake-drop-rock 900ms ease-in-out infinite;
}

@keyframes cake-drop-rock {
  0%,
  100% {
    transform: rotate(-1.4deg);
  }

  50% {
    transform: rotate(1.4deg);
  }
}

.cake-drop-plate {
  position: absolute;
  bottom: 0;
  left: 50%;

  border: 5px solid var(--ink);
  border-radius: 10px 10px 24px 24px;

  background: var(--paper);

  transform: translateX(-50%);
}

.cake-drop-tower--toppling {
  animation:
    cake-drop-topple
    820ms
    cubic-bezier(.35, .05, .7, 1)
    forwards;
}

@keyframes cake-drop-topple {
  0% {
    transform: rotate(0);
  }

  25% {
    transform: rotate(-7deg);
  }

  100% {
    transform: rotate(88deg) translateY(54px);
    opacity: 0.25;
  }
}

.cake-drop-face {
  position: absolute;
  inset: 0;
}

.cake-drop-eye {
  position: absolute;
  top: 8px;

  width: 7px;
  height: 7px;

  border-radius: 50%;
  background: var(--ink);
}

.cake-drop-eye--left {
  left: 35%;
}

.cake-drop-eye--right {
  right: 35%;
}

.cake-drop-smile {
  position: absolute;
  top: 16px;
  left: 50%;

  width: 20px;
  height: 10px;

  border-bottom: 4px solid var(--ink);
  border-radius: 0 0 30px 30px;

  transform: translateX(-50%);
}

.cake-drop-cherry {
  position: absolute;
  top: -19px;
  left: 50%;

  width: 19px;
  height: 19px;

  border: 4px solid var(--ink);
  border-radius: 50%;

  background: var(--tomato);

  transform: translateX(-50%);
}

.cake-drop-splat {
  position: absolute;

  height: 20px;

  border: 5px solid var(--ink);
  border-radius: 999px;

  transform: translateX(-50%);

  animation:
    cake-drop-splat
    420ms
    cubic-bezier(.2, 1.5, .4, 1)
    forwards;
}

.cake-drop-splat--tomato {
  background: var(--tomato);
}

.cake-drop-splat--sun {
  background: var(--sun);
}

.cake-drop-splat--sea {
  background: var(--sea);
}

@keyframes cake-drop-splat {
  0% {
    transform: translateX(-50%) scale(.7, 1.6);
  }

  45% {
    transform: translateX(-50%) scale(1.13, .84);
  }

  100% {
    transform: translateX(-50%) scale(1);
  }
}

.cake-drop-action {
  width: 100%;
  min-height: 66px;

  padding: 9px 24px;

  border: 5px solid var(--ink);
  border-radius: 999px;

  background: var(--tomato);
  color: var(--ink);

  box-shadow: 0 5px 0 rgb(42 33 24 / 15%);

  font-size: 1.55rem;

  cursor: pointer;
}

.cake-drop-action:disabled {
  opacity: 0.45;
}

.cake-drop-action:active:not(:disabled) {
  transform: translateY(5px) scale(.98);
  box-shadow: none;
}

.cake-drop-mode {
  justify-self: center;

  min-height: 38px;
  padding: 5px 15px;

  font-size: 0.78rem;
}

@media (max-height: 700px) {
  .cake-drop-game {
    padding-top: 7px;
    padding-bottom: 9px;
    gap: 6px;
  }

  .cake-drop-topbar h1 {
    font-size: 2.25rem;
  }

  .cake-drop-player {
    min-height: 52px;
  }

  .cake-drop-action {
    min-height: 56px;
  }
}

@media (max-width: 700px) {
  .cake-drop-game {
    padding-left: 12px;
    padding-right: 12px;
  }

  .cake-drop-topbar {
    gap: 8px;
  }

  .cake-drop-topbar h1 {
    font-size: clamp(1.9rem, 8vw, 2.7rem);
  }

  .cake-drop-hud {
    gap: 7px;
  }

  .cake-drop-player {
    padding: 6px 8px;
  }

  .cake-drop-player span {
    font-size: 0.78rem;
  }

  .cake-drop-stats span {
    min-width: 52px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .cake-drop-tower--toppling,
  .cake-drop-splat {
    animation-duration: 1ms;
  }

  .cake-drop-tower--tipping {
    animation: none;
  }
}
